{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dora-dotcom/editable-slide-templates/blob/main/schema.json",
  "title": "Editable Slide Template Meta",
  "description": "Schema for presets/<id>/meta.json — machine-readable metadata for a single editable slide template.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "vibe", "mood", "category", "lightDark", "typography", "colors", "capabilities", "source"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Pinned to 1 for this version of the contract."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Kebab-case unique ID. Must match the folder name in presets/."
    },
    "name": {
      "type": "string",
      "description": "Human-readable preset name (Title Case)."
    },
    "vibe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "bold", "clean", "professional", "experimental", "energetic",
          "calm", "warm", "playful", "elegant", "minimal", "editorial",
          "retro", "futuristic", "brutalism", "handwritten", "modular",
          "monochrome", "academic", "luxe", "indie", "activist"
        ]
      },
      "description": "Vibe tags — drives mood-based recommendation in skill Phase 2."
    },
    "mood": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["impressed", "excited", "calm", "inspired"]
      },
      "description": "Aligns with the four moods the skill asks the user about."
    },
    "category": {
      "type": "string",
      "enum": [
        "dark", "light", "specialty", "brutalism", "retro-pixel",
        "retro-zine", "handwriting", "bold-poster", "editorial",
        "mid-century", "minimal", "modular", "activist", "playful"
      ]
    },
    "lightDark": {
      "enum": ["light", "dark"],
      "description": "Dominant theme — used to pick the deck chrome contrast preset."
    },
    "typography": {
      "type": "object",
      "required": ["display", "body", "source"],
      "additionalProperties": false,
      "properties": {
        "display": { "type": "string" },
        "body": { "type": "string" },
        "mono": { "type": "string" },
        "source": {
          "enum": ["google-fonts", "fontshare", "system", "self-hosted"]
        }
      }
    },
    "colors": {
      "type": "object",
      "description": "Free-form color tokens. Keys are arbitrary; values must be CSS color strings.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(#[0-9a-fA-F]{3,8}|rgb|rgba|hsl|hsla|var|color-mix|oklch|oklab|transparent|currentColor|inherit|initial|unset).*$"
      },
      "minProperties": 2
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdfExport", "imageUpload"],
      "properties": {
        "pdfExport": {
          "type": "boolean",
          "description": "Template ships with exportPdf() function and sidebar button."
        },
        "imageUpload": {
          "type": "boolean",
          "description": "Template supports + Add Image button and double-click image replace."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["origin"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "description": "Either 'original' (authored for this repo) or an upstream identifier like 'zarazhang/beautiful-html-templates'."
        },
        "license": {
          "type": "string",
          "description": "SPDX identifier of the upstream license, if derived."
        },
        "originalUrl": {
          "type": "string",
          "format": "uri",
          "description": "Direct link to the original file, if derived."
        },
        "originalPath": {
          "type": "string",
          "description": "Path within the upstream repo, if derived."
        }
      }
    },
    "ported": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string" },
        "date": {
          "type": "string",
          "format": "date"
        },
        "notes": { "type": "string" }
      }
    },
    "screenshot": {
      "type": "string",
      "description": "Relative path to the hero screenshot. Defaults to screenshot.png if omitted."
    },
    "thumb": {
      "type": "string",
      "description": "Relative path to the list thumbnail. Defaults to thumb.png if omitted."
    }
  }
}
